# ────────────────────────────────────────────────────────────────────────────
#  Variables d'environnement — Phase 2 (persistance + email)
#  Copiez ce fichier en `.env.local` et remplissez les valeurs.
#  Sur Vercel : Project → Settings → Environment Variables.
#  SANS ces variables, le site fonctionne en Phase 1 (WhatsApp uniquement).
# ────────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
# URL du projet (https://xxxx.supabase.co) — publique (auth + serveur)
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon/public (auth admin côté navigateur) — publique
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role (SECRÈTE — serveur uniquement, jamais exposée au client)
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com → API Keys
RESEND_API_KEY=
# Expéditeur vérifié (domaine vérifié sur Resend). Ex : "PhysioFit <rdv@votre-domaine.ma>"
# Par défaut, Resend autorise "onboarding@resend.dev" pour les tests.
RESEND_FROM=
# Destinataire des notifications (par défaut : l'email du cabinet dans lib/site.ts)
RESEND_TO=
